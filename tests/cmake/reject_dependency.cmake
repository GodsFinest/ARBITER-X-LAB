include(CMakePackageConfigHelpers)
set(root "${BUILD_DIR}/rejected-${CASE}")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/prefix/lib/cmake/ArbiterX")
set(pkg "${root}/prefix/lib/cmake/ArbiterX")
if(CASE STREQUAL "version")
  set(version 1.2.0)
  set(api 1)
else()
  set(version 1.1.0)
  set(api 2)
endif()
write_basic_package_version_file("${pkg}/ArbiterXConfigVersion.cmake" VERSION ${version} COMPATIBILITY SameMajorVersion)
file(WRITE "${pkg}/ArbiterXConfig.cmake" "add_library(ArbiterX::core INTERFACE IMPORTED)\nset_target_properties(ArbiterX::core PROPERTIES ARBITER_X_VERSION ${version} ARBITER_X_API_VERSION ${api})\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${LAB_SOURCE}" -B "${root}/build" "-DArbiterX_DIR=${pkg}" -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0)
  message(FATAL_ERROR "Unsupported ${CASE} was accepted")
endif()
if(CASE STREQUAL "api" AND NOT "${output}${error}" MATCHES "Unsupported ArbiterX version/API")
  message(FATAL_ERROR "Configuration failed for an unrelated reason: ${output}${error}")
endif()
if(CASE STREQUAL "version" AND NOT "${output}${error}" MATCHES "1.2.0")
  message(FATAL_ERROR "Version failure did not identify the incompatible package: ${output}${error}")
endif()
